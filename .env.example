# Public TEST Payment Link from Stripe Dashboard (https://buy.stripe.com/...).
# Leave empty to keep the unpaid demo open. Do not use a live Payment Link locally.
STRIPE_PAYMENT_LINK_URL=

# Stripe secret key. Local work must use TEST mode (sk_test_...), never sk_live_.
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_...) from Stripe CLI `listen` or Dashboard.
STRIPE_WEBHOOK_SECRET=

# HMAC secret for the signed httpOnly access cookie. Generate locally; do not commit.
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PAYMENT_ACCESS_SECRET=

APP_URL=http://localhost:3010
